# H-Kids API — copy to apps/api/.env and adjust values.
# Never commit real secrets.

NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Preferred: full connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hkids_admin_ai

# Or compose from parts (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hkids_admin_ai
DB_SSL=false

# Connection tuning
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=500

# Auth
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_MS=604800000
DEFAULT_ADMIN_EMAIL=admin@hkids.app
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_NAME=H-Kids Administrator

# AI Gateway (Claude default)
ANTHROPIC_API_KEY=
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-3-5-sonnet-latest
MAX_TOKENS=1500
TEMPERATURE=0.3
ENABLE_STREAMING=false
MAX_RETRIES=2
REQUEST_TIMEOUT_MS=30000
ENABLE_USAGE_TRACKING=true

# Embeddings (mock by default in development)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-v1
OPENAI_API_KEY=

# HTTP limits
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Testing / local overrides
# HKIDS_USE_IN_MEMORY_DB=true
# FORCE_REAL_DATABASE=true
