{
  "name": "assistant-administratif-ia",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @hkids/web\" \"npm run dev -w @hkids/api\"",
    "dev:e2e": "concurrently \"npm run dev -w @hkids/api\" \"npm run dev -w @hkids/web -- --host 127.0.0.1 --port 5174 --strictPort\"",
    "build": "npm run build -w @hkids/web && npm run build -w @hkids/api",
    "lint": "npm run lint -w @hkids/web && npm run lint -w @hkids/api",
    "typecheck": "npm run typecheck -w @hkids/web",
    "quality:gates": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "npm run test -w @hkids/api && npm run test -w @hkids/web",
    "test:e2e": "node ./scripts/run-e2e.mjs",
    "db:ensure": "npm run db:ensure -w @hkids/api",
    "backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup.ps1",
    "restore": "powershell -ExecutionPolicy Bypass -File ./scripts/restore.ps1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.6.2"
  }
}
