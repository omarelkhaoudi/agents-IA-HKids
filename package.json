{
  "name": "assistant-administratif-ia",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @hkids/web\" \"npm run dev -w @hkids/api\"",
    "build": "npm run build -w @hkids/web && npm run build -w @hkids/api",
    "lint": "npm run lint -w @hkids/web && npm run lint -w @hkids/api",
    "test": "npm run test -w @hkids/api && npm run test -w @hkids/web",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "pdf-lib": "^1.17.1"
  }
}
